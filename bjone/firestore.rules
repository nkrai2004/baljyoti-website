rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleDoc() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }
    function activeUser() {
      return signedIn()
        && roleDoc().data.active == true
        && roleDoc().data.email == request.auth.token.email;
    }
    function role() { return activeUser() ? roleDoc().data.role : ""; }
    function hasRole(roles) { return activeUser() && role() in roles; }

    function canRead(moduleName) {
      return hasRole([
        'Teacher','Administrator','Principal','Director','Accountant',
        'Coordinator','HR Manager','Transport Manager','Librarian','Exam Coordinator'
      ]) && (
        role() == 'Director' ||
        (moduleName == 'teachingTools') ||
        (moduleName == 'dailyReports' && role() in ['Teacher','Administrator','Principal','Coordinator']) ||
        (moduleName == 'staffManagement' && role() in ['Administrator','Principal','Director','HR Manager']) ||
        (moduleName == 'studentManagement' && role() in ['Administrator','Principal','Director','Accountant','Coordinator','Transport Manager','Librarian','Exam Coordinator']) ||
        (moduleName == 'academicManagement' && role() in ['Teacher','Administrator','Principal','Director','Coordinator','Exam Coordinator']) ||
        (moduleName == 'attendance' && role() in ['Teacher','Administrator','Principal','Director','Coordinator','HR Manager']) ||
        (moduleName == 'feeManagement' && role() in ['Administrator','Principal','Director','Accountant']) ||
        (moduleName == 'transport' && role() in ['Administrator','Principal','Director','Transport Manager']) ||
        (moduleName == 'library' && role() in ['Administrator','Principal','Director','Librarian']) ||
        (moduleName == 'examinations' && role() in ['Administrator','Principal','Director','Exam Coordinator']) ||
        (moduleName == 'reports' && role() in ['Administrator','Principal','Director','Accountant','Coordinator','HR Manager','Transport Manager','Exam Coordinator']) ||
        (moduleName == 'settings' && role() in ['Administrator','Director'])
      );
    }

    function canWrite(moduleName) {
      return role() == 'Director' ||
        (moduleName == 'dailyReports' && role() in ['Teacher','Administrator','Coordinator']) ||
        (moduleName == 'staffManagement' && role() in ['Administrator','HR Manager']) ||
        (moduleName == 'studentManagement' && role() == 'Administrator') ||
        (moduleName == 'academicManagement' && role() in ['Administrator','Principal','Coordinator']) ||
        (moduleName == 'attendance' && role() in ['Administrator','Coordinator']) ||
        (moduleName == 'feeManagement' && role() in ['Administrator','Accountant']) ||
        (moduleName == 'transport' && role() in ['Administrator','Transport Manager']) ||
        (moduleName == 'library' && role() in ['Administrator','Librarian']) ||
        (moduleName == 'examinations' && role() in ['Administrator','Exam Coordinator']) ||
        (moduleName == 'settings' && role() == 'Administrator');
    }

    // Each user can read only their own role record. Director manages role assignments.
    match /userRoles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasRole(['Director']));
      allow create, update, delete: if hasRole(['Director']);
    }

    // Put module records under moduleData/{moduleKey}/{documentId}.
    // The client UI is not a security boundary; these rules enforce data access.
    match /moduleData/{moduleName}/{documentId} {
      allow get, list: if canRead(moduleName);
      allow create, update, delete: if canWrite(moduleName);
    }

    // Default deny for all collections not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}