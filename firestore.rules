rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().status == 'active'
        && userDoc().email == request.auth.token.email;
    }
    function superAdmin() {
      return activeUser() && userDoc().role == 'super_admin';
    }
    function attendanceManager() {
      return activeUser()
        && userDoc().role in ['super_admin', 'admin', 'academic_coordinator'];
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || superAdmin());
      allow list: if superAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email.matches('.*@baljyoti[.]com')
        && request.resource.data.role == 'staff'
        && request.resource.data.accountType == 'staff'
        && request.resource.data.status == 'pending';
      allow update, delete: if superAdmin();
    }
    match /system/{document} {
      allow get, list: if activeUser();
      allow create, update, delete: if superAdmin();
    }
    match /userModuleOverrides/{uid} {
      allow get: if activeUser() && (request.auth.uid == uid || superAdmin());
      allow list: if superAdmin();
      allow create, update, delete: if false;
    }
    // Daily teacher attendance: restricted to active Admin / Academic Coordinator roles.
    match /attendanceRecords/{recordId} {
      allow get, list: if attendanceManager();
      allow create, update: if attendanceManager()
        && request.resource.data.date is string
        && request.resource.data.email is string
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }
    match /attendanceImports/{importId} {
      allow get, list: if attendanceManager();
      allow create: if attendanceManager()
        && request.resource.data.uploadedBy == request.auth.token.email;
      allow update, delete: if false;
    }
    match /attendanceAudit/{auditId} {
      allow get, list: if attendanceManager();
      allow create: if attendanceManager()
        && request.resource.data.changedBy == request.auth.token.email;
      allow update, delete: if false;
    }
    // All other operational collections remain closed until separately approved.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}